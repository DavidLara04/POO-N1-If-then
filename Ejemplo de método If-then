-Ejemplo de método If-then

public class Persona {
    private int edad;

    public Persona(int edad) {
        this.edad = edad;
    }
//Método If-then-else
    public void verificarMayorEdad() {
        if (edad >= 18) {
            System.out.println("La persona es mayor de edad.");
        }
    }
}

-Uso en el método main
public class Main {
    public static void main(String[] args) {
        Persona persona1 = new Persona(20);
        persona1.verificarMayorEdad();
    }
}
